# ==============================================================
# FLOWTIVE CENTRAL — Environment Variables
# Copy this to .env.local for development.
# Set these as environment variables in Railway / Vercel dashboards.
# NEVER commit .env.local to git.
# ==============================================================

# ── Frontend (Next.js) ─────────────────────────────────────────
# Full URL to the PHP backend (no trailing slash)
# Dev:        http://localhost/flowtive-central
# Production: https://your-app.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost/flowtive-central

# App public URL (used for reset-password links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend (PHP / Railway) ────────────────────────────────────
# MySQL / PostgreSQL connection
DB_HOST=localhost
DB_NAME=flowtive_erp
DB_USER=root
DB_PASS=

# Use 'mysql' for XAMPP/Railway MySQL, 'pgsql' for Supabase
DB_DRIVER=mysql

# Supabase connection string (used when DB_DRIVER=pgsql)
# Get from: Supabase dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Secret used to encrypt stored M-Pesa credentials — change this!
APP_SECRET=change-me-to-a-random-32-char-string

# App timezone (IANA format)
APP_TIMEZONE=Africa/Nairobi

# Backend public URL (used for Daraja STK callback URL)
BACKEND_URL=http://localhost/flowtive-central

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── M-Pesa / Daraja (optional — leave blank to use manual mode) ──
# Set mpesa_enabled to 'manual' | 'daraja' in app Settings
# Credentials are stored encrypted in the database via the Settings UI
# (You do NOT need to set them here — use the in-app Settings page)

# ── Vercel (auto-injected by Vercel, listed here for reference) ──
# VERCEL_URL=your-app.vercel.app
